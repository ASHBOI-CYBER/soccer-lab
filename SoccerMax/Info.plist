<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key><string>en</string>
	<key>CFBundleDisplayName</key><string>Soccer Lab</string>
	<key>CFBundleExecutable</key><string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIdentifier</key><string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key><string>6.0</string>
	<key>CFBundleName</key><string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key><string>APPL</string>
	<key>CFBundleShortVersionString</key><string>$(MARKETING_VERSION)</string>
	<key>CFBundleVersion</key><string>$(CURRENT_PROJECT_VERSION)</string>
	<key>POSTHOG_PROJECT_TOKEN</key><string>$(POSTHOG_PROJECT_TOKEN)</string>
	<key>POSTHOG_HOST</key><string>https://us.i.posthog.com</string>
	<key>REVENUECAT_API_KEY</key><string>$(REVENUECAT_API_KEY)</string>
	<key>LSRequiresIPhoneOS</key><true/>
	<key>NSSupportsLiveActivities</key><true/>
	<key>NSLocationWhenInUseUsageDescription</key><string>Find soccer teams near you, and drop a dot on the Map where you trained (rounded so no exact address is ever shared).</string>
	<key>NSContactsUsageDescription</key><string>Invite friends from your contacts to your team. Your contacts stay on your phone and are never uploaded.</string>
	<!-- team invite links: soccermax://join/ABC123 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleURLName</key><string>com.jacksteiner.soccermax</string>
			<key>CFBundleURLSchemes</key><array><string>soccermax</string></array>
		</dict>
	</array>
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key><string>LaunchBackground</string>
	</dict>
	<key>UIApplicationSceneManifest</key>
	<dict>
		<key>UIApplicationSupportsMultipleScenes</key><false/>
	</dict>
	<!-- Portrait only on every iPhone screen. Landscape is listed ONLY so the iPhone Duo's big inner display
	     (regular x regular) can fill the screen instead of showing a shrunken portrait box ? AppDelegate
	     supportedInterfaceOrientationsFor returns .portrait everywhere else (2026-11-01, notes/19). -->
	<key>UISupportedInterfaceOrientations</key>
	<array>
		<string>UIInterfaceOrientationPortrait</string>
		<string>UIInterfaceOrientationLandscapeLeft</string>
		<string>UIInterfaceOrientationLandscapeRight</string>
	</array>
	<key>UIRequiresFullScreen</key><true/>
	<key>UIUserInterfaceStyle</key><string>Dark</string>
	<key>ITSAppUsesNonExemptEncryption</key><false/>
</dict>
</plist>
